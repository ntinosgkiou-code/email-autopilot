{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(uv run tools/guard.py:*)",
      "Bash(uv run tools/mailer.py:*)",
      "Bash(uv run tools/finder.py:*)",
      "Read",
      "Edit(data/**)",
      "Edit(config.yaml)"
    ],
    "deny": [
      "Read(data/.secrets/**)"
    ]
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000"
  }
}
